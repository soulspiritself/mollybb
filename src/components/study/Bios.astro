---
import type { Person } from '../../data/study/types';
interface Props { people: Person[]; compact?: boolean }
const { people, compact = false } = Astro.props;
---
<div class:list={['bios', { 'bios--compact': compact }]}>
  {people.map((p) => (
    <article class="bio" id={p.id}>
      <p class="bio__dates">{p.dates}</p>
      <h3 class="bio__name">{p.name}</h3>
      <p class="bio__role">{p.role}</p>
      <p class="bio__body">{p.bio}</p>
      {p.tags && <p class="bio__tags">{p.tags.join(' · ')}</p>}
    </article>
  ))}
</div>

<style>
  .bios { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
  .bio {
    padding: 1.4rem 1.3rem 1.2rem;
    border: 1px solid var(--black-line);
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(201,169,110,0.04), transparent);
  }
  .bio__dates { font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); margin-bottom: 0.4rem; }
  .bio__name { font-family: var(--serif); font-size: 1.5rem; color: var(--text); margin-bottom: 0.15rem; }
  .bio__role { font-size: 0.8rem; color: var(--text-faint); margin-bottom: 0.7rem; letter-spacing: 0.02em; }
  .bio__body { font-size: 0.93rem; color: var(--text-muted); margin: 0; }
  .bio__tags { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold-deep); margin: 0.8rem 0 0; }
  .bios--compact .bio__body { display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
</style>
