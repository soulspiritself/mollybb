---
import BaseLayout from './BaseLayout.astro';
import StudyNav from '../components/study/StudyNav.astro';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  lead?: string;
  /** Which study sub-nav item is active (matches StudyNav slugs). */
  current?: string;
}

const {
  title,
  description = 'Study plan 2026 to 2028. Unlisted.',
  eyebrow = 'Study',
  lead,
  current = '',
} = Astro.props;
---
<BaseLayout title={title} description={description} noindex={true}>
  <StudyNav current={current} />
  <section class="study-hero">
    <div class="wrap">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="study-hero__title">{title}</h1>
      <hr class="rule" />
      {lead && <p class="study-hero__lead">{lead}</p>}
    </div>
  </section>
  <div class="study-body">
    <slot />
  </div>
</BaseLayout>

<style is:global>
  /* ---- Study section: shared styles (global so child components share them) ---- */
  .study-hero { padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2rem, 5vw, 3rem); }
  .study-hero__title {
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    margin-bottom: 1.25rem;
    color: var(--text);
  }
  .study-hero__lead {
    max-width: 62ch;
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    line-height: 1.45;
    color: var(--text-muted);
    margin-top: 1.5rem;
  }
  .study-body { padding-bottom: clamp(4rem, 10vw, 7rem); }

  .study-section { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .study-section + .study-section { border-top: 1px solid var(--black-line); }
  .study-section__title {
    font-size: clamp(1.7rem, 4vw, 2.5rem);
    margin-bottom: 0.75rem;
    color: var(--text);
  }
  .study-section__intro {
    max-width: 68ch;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
  }
  .study-h3 {
    font-size: 1.35rem;
    margin: 2rem 0 0.75rem;
    color: var(--gold-bright);
  }
  .study-prose { max-width: 68ch; color: var(--text-muted); }
  .study-prose p { margin-bottom: 1rem; }
  .study-prose strong { color: var(--text); font-weight: 600; }
  .study-prose ul, .study-prose ol { padding-left: 1.25rem; margin: 0 0 1rem; }
  .study-prose li { margin-bottom: 0.4rem; }
  .study-prose li::marker { color: var(--gold); }

  /* Tables */
  .study-table-wrap { overflow-x: auto; margin: 1rem 0 1.5rem; border: 1px solid var(--black-line); border-radius: 12px; }
  .study-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .study-table th, .study-table td { padding: 0.7rem 0.9rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--black-line); }
  .study-table th {
    font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 600;
    color: var(--gold); background: var(--black-soft); white-space: nowrap;
  }
  .study-table tr:last-child td { border-bottom: 0; }
  .study-table td { color: var(--text-muted); }
  .study-table td:first-child { color: var(--text); white-space: nowrap; }
  .study-table tr.is-now td { background: rgba(201,169,110,0.08); }
  .study-table tr.is-now td:first-child { color: var(--gold-bright); }
  .study-table tr.is-break td { color: var(--text-faint); font-style: italic; }
  .study-table .ms { color: var(--gold-bright); font-weight: 600; }

  /* Cards */
  .study-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
  .study-card {
    display: block;
    padding: 1.5rem 1.4rem;
    border: 1px solid var(--black-line);
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(201,169,110,0.05), transparent);
    color: var(--text);
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  a.study-card:hover { border-color: var(--gold); transform: translateY(-3px); color: var(--text); }
  .study-card__kicker { font-size: 0.66rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--gold); margin-bottom: 0.5rem; }
  .study-card__title { font-family: var(--serif); font-size: 1.45rem; margin-bottom: 0.4rem; color: var(--text); }
  .study-card__body { font-size: 0.92rem; color: var(--text-muted); margin: 0; }
  .study-card__meta { font-size: 0.75rem; color: var(--text-faint); margin-top: 0.75rem; letter-spacing: 0.04em; }

  /* Callouts */
  .study-callout {
    border-left: 2px solid var(--gold);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    background: var(--black-soft);
    border-radius: 0 12px 12px 0;
    color: var(--text-muted);
    max-width: 72ch;
  }
  .study-callout strong { color: var(--gold-bright); }

  /* Milestone list */
  .milestones { display: grid; gap: 0.75rem; }
  .milestone {
    display: grid; grid-template-columns: 4.5rem 1fr; gap: 1rem;
    padding: 1rem 1.2rem; border: 1px solid var(--black-line); border-radius: 12px;
  }
  .milestone__code { font-family: var(--serif); font-size: 1.6rem; color: var(--gold); line-height: 1; }
  .milestone__when { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 0.3rem; }
  .milestone__q { color: var(--text); font-family: var(--serif); font-size: 1.15rem; line-height: 1.35; margin-bottom: 0.4rem; }
  .milestone__note { font-size: 0.9rem; color: var(--text-muted); margin: 0; }

  @media (max-width: 540px) {
    .milestone { grid-template-columns: 1fr; }
    .study-table { font-size: 0.85rem; }
  }
</style>
