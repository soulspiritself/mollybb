---
import StudyLayout from '../../layouts/StudyLayout.astro';
import Section from '../../components/study/Section.astro';
import Table from '../../components/study/Table.astro';
import Milestones from '../../components/study/Milestones.astro';
import Bios from '../../components/study/Bios.astro';
import { PAPERS, PHIL, ETHICS, CHRISTIAN, MILESTONES, LEVELS, ESSAYS } from '../../data/study/rs';
import { byTag } from '../../data/study/people';
---
<StudyLayout
  title="Religious Studies"
  eyebrow="OCR H573 · three papers · no coursework"
  lead="Thirty topics, one essay form. Each paper sets four essays and you answer three, forty marks and forty minutes each. Argument is worth more than knowledge in every essay, so a well-argued essay with adequate knowledge beats a knowledgeable essay that describes."
  current="rs"
>
  <Section title="The exam" intro="Each essay is 16 marks AO1 (knowledge and understanding) and 24 marks AO2 (analysis and evaluation), marked on a six-level grid. Questions can come from any topic, so nothing is dropped.">
    <Table head={PAPERS.head} rows={PAPERS.rows} />
  </Section>

  <Section title="The method" intro="Each topic takes about ten days, alternating papers so you never spend a term inside one way of thinking.">
    <div class="study-prose">
      <ol>
        <li><strong>Read the Hodder chapter</strong> (about 20 pages) in the reading slot, making a two-page summary in your own words.</li>
        <li><strong>Build the topic sheet:</strong> one A4 page. Key ideas in the left column, criticisms and counter-criticisms in the middle, named scholars with one quotable sentence each on the right. It must fit on one page.</li>
        <li><strong>The for-and-against table:</strong> for each of the two or three obvious questions on the topic, three arguments each way and a judgement.</li>
        <li><strong>Write one 40-mark essay in 40 minutes.</strong> Not a plan. The whole essay, timed, marked the same day.</li>
        <li><strong>Read a model essay</strong> (Baron's book) on the same or a neighbouring question afterwards, never before. Note two things the model did that yours did not.</li>
      </ol>
      <p><strong>The one essay form you need.</strong> A four-sentence introduction: define the key term, state the thesis, name the thinkers. Three or four paragraphs, each with a claim, the scholar or argument that supports it, the strongest objection, your response to the objection, and a sentence back to the question. A four-sentence conclusion: the judgement, the decisive reason, the strongest opposing point and why it fails.</p>
      <p>The single habit that lifts AO2 from level 4 to level 6 is answering the objection inside the paragraph. Most students present view A, then view B, then conclude. Examiners want you to weigh them mid-paragraph.</p>
      <p><strong>Links page</strong> for synoptic credit: Natural Law to Augustine; Kant to Christian moral principles; religious experience to knowledge of God; problem of evil to death and afterlife; Hick on evil and Hick on pluralism; Freud on conscience and Freud on secularism. One sentence drawing a link is worth having in every essay.</p>
    </div>
  </Section>

  <Section title="Philosophy of Religion (H573/01)" intro="Nine topics. Taught in Terms 1, 2, 3 and 4.">
    <div class="study-grid">
      {PHIL.map((t) => (
        <article class="study-card"><p class="study-card__kicker">{t.weeks}</p><h3 class="study-card__title">{t.title}</h3><p class="study-card__body">{t.intro}</p></article>
      ))}
    </div>
  </Section>
  <Section title="Religion and Ethics (H573/02)" intro="Nine topics. Meta-ethics is taught early because it sharpens every other essay.">
    <div class="study-grid">
      {ETHICS.map((t) => (
        <article class="study-card"><p class="study-card__kicker">{t.weeks}</p><h3 class="study-card__title">{t.title}</h3><p class="study-card__body">{t.intro}</p></article>
      ))}
    </div>
  </Section>
  <Section title="Developments in Christian Thought (H573/03)" intro="Twelve topics. Begins in Term 3 and finishes in Term 5.">
    <div class="study-grid">
      {CHRISTIAN.map((t) => (
        <article class="study-card"><p class="study-card__kicker">{t.weeks}</p><h3 class="study-card__title">{t.title}</h3><p class="study-card__body">{t.intro}</p></article>
      ))}
    </div>
  </Section>

  <Section title="Essay titles by topic" intro="One full essay per topic, in the week shown. The milestones below are the ones marked with the full grid and logged.">
    <Table head={['Weeks', 'Topic', 'Essay written']} rows={ESSAYS.map((e) => [e.weeks, e.topic, (e.milestone ? `<span class="ms">${e.milestone}</span> ` : '') + e.essay])} />
    <p class="study-prose">From April 2028: second mocks in the week of 24 April, then three timed essays a week, one per paper, drawn from every past question OCR has set since 2018 (about 150), tallied so each topic is written on at least twice. By then you should hold a bank of forty ten-bullet essay plans.</p>
  </Section>

  <Section title="Milestones">
    <Milestones items={MILESTONES} />
  </Section>

  <Section title="Marking guide" intro="Mark AO1 and AO2 separately, with the OCR grid.">
    <Table head={LEVELS.head} rows={LEVELS.rows} />
    <p class="study-prose"><strong>Failure points from examiners' reports:</strong> answering the topic rather than the question set; view A, view B, conclusion, with no weighing; conclusions that introduce new material; padding the introduction with biography; scholars' names used as decoration.</p>
  </Section>

  <Section title="Who's who: Philosophy of Religion">
    <Bios people={byTag('philosophy')} />
  </Section>
  <Section title="Who's who: Ethics">
    <Bios people={byTag('ethics').filter((p) => !p.tags?.includes('philosophy'))} />
  </Section>
  <Section title="Who's who: Christian Thought">
    <Bios people={byTag('christian').filter((p) => !p.tags?.includes('philosophy') && !p.tags?.includes('ethics'))} />
  </Section>
</StudyLayout>
